PORT=5000
MONGODB_URI=mongodb://localhost:27017/livestock-tracker
JWT_SECRET=your_jwt_secret_key

# No-reply Email Configuration
NOREPLY_EMAIL=noreply@farmtracker.com
NOREPLY_NAME=FarmTracker Automated Reports

# (Optional) Real SMTP Provider Configuration (Gmail, Brevo, Sendgrid, Mailtrap, AWS SES, etc.)
# If left empty, emails will be delivered in simulated mode and logged to server/outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
